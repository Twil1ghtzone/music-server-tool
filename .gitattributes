# Der Stack laeuft unter Linux. CRLF wuerde die Shebang in
# docker-entrypoint.sh zerstoeren, deshalb ueberall LF erzwingen.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.mp3 binary

# Schriften sind Binaerdateien. "text=auto" erkennt das normalerweise selbst,
# aber ein falsch erkanntes woff2 waere unbrauchbar und faellt erst im
# Browser auf - deshalb ausdruecklich.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
