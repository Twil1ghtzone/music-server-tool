# ---------------------------------------------------------------------------
# music-server-tool -- OPTIONAL
#
# Der Stack laeuft ohne diese Datei. Jeder Wert hier hat in
# docker-compose.yml eine Vorgabe, und was fehlt, erzeugt oder besorgt sich
# der Gateway beim Start selbst:
#   - Dashboard-Passwort  -> wird erzeugt und einmalig ins Log geschrieben
#   - Session-Geheimnis   -> wird erzeugt und unter /data abgelegt
#   - Navidrome-Zugang    -> Token des ersten angemeldeten Clients
#
# Diese Datei ist also nur fuer den, der etwas festlegen statt erzeugen lassen
# will:
#
#   cp .env.example .env && chmod 600 .env
#
# Die Pfade stehen direkt in docker-compose.yml (/mnt/tank/music,
# /mnt/tank/music-staging, /mnt/tank/music-quarantine).
# ---------------------------------------------------------------------------

TZ=Europe/Berlin
LOG_LEVEL=info

# --- Navidrome ------------------------------------------------------------
# Der Admin-Account aus Navidrome. Der Gateway nutzt ihn ausschliesslich, um
# Scans auszuloesen und neu importierte Titel auf ihre Navidrome-ID
# aufzuloesen. Bleibt das Passwort leer, haengen Downloads auf "importing".
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=

# --- Deemix ---------------------------------------------------------------
# 1 = MP3 128 | 3 = MP3 320 | 9 = FLAC
# Der ARL wird weiterhin in der Deemix-Oberflaeche hinterlegt und liegt in
# ./config/deemix - hier ist er absichtlich nicht noetig.
DEEMIX_BITRATE=3

# --- Dashboard-Login ------------------------------------------------------
# Wird beim ersten Start angelegt. Danach im Dashboard aenderbar.
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=

# Pflicht. Erzeugen mit:  openssl rand -hex 32
# Bleibt das leer, wird bei jedem Neustart ein neues erzeugt und alle
# angemeldeten Browser fliegen raus.
GATEWAY_SESSION_SECRET=

# Auf true, sobald das Dashboard hinter HTTPS laeuft (Secure-Flag auf Cookies).
GATEWAY_SECURE_COOKIES=false

# --- Verhalten beim Abspielen nicht geladener Titel ------------------------
#   defer  = kurzer Hinweiston, Download laeuft im Hintergrund (robust)
#   stream = Verbindung offen halten und live mitstreamen (bessere UX,
#            aber kein Seeking, und Clients mit kurzem Timeout steigen aus)
# Mit defer starten. Erst umstellen, wenn das laeuft.
GATEWAY_STREAM_MODE=defer

# Marker hinter noch nicht geladenen Titeln in der Client-Suche.
GATEWAY_MARKER_SUFFIX=[Nicht heruntergeladen]

# --- Import ---------------------------------------------------------------
#   preserve = die Struktur uebernehmen, die Deemix anhand seiner eigenen
#              Templates erzeugt. Standard, weil der bestehende Bestand von
#              genau denselben Templates stammt.
#   tags     = Zielpfad selbst ableiten (Interpret/Album/NN - Titel)
GATEWAY_IMPORT_LAYOUT=preserve

# --- Schutzschalter fuer den vorhandenen Bestand --------------------------
# Beide bewusst aus. Der Import legt nur neue Dateien an; alles, was
# vorhandene Dateien anfasst, muss ausdruecklich freigeschaltet werden.
# Erst die Vorschlaege im Dashboard pruefen, dann einschalten.
GATEWAY_ALLOW_DEDUPE_APPLY=false
GATEWAY_ALLOW_TAG_WRITE=false

# --- Worker ---------------------------------------------------------------
GATEWAY_WORKER_CONCURRENCY=2
