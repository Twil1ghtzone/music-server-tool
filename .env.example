# ---------------------------------------------------------------------------
# music-server-tool / music-gateway  --  Beispiel-Konfiguration
# Kopieren nach .env und anpassen:  cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- Host-Pfade (TrueNAS SCALE) -------------------------------------------
# Die fertige Bibliothek, die Navidrome liest.
MUSIC_DIR=/mnt/tank/music
# Ablage, in die Deemix zuerst herunterlaedt. Der Gateway taggt, prueft und
# verschiebt von hier in MUSIC_DIR. NICHT identisch mit MUSIC_DIR waehlen.
STAGING_DIR=/mnt/tank/music-staging
# Geloeschte Duplikate landen hier, statt sofort zu verschwinden.
QUARANTINE_DIR=/mnt/tank/music-quarantine

# --- Benutzer / Rechte ----------------------------------------------------
PUID=1000
PGID=1000
TZ=Europe/Berlin

# --- Ports ----------------------------------------------------------------
GATEWAY_PORT=8080
NAVIDROME_PORT=4533
DEEMIX_PORT=6595

# --- Navidrome ------------------------------------------------------------
# Admin-Account in Navidrome. Der Gateway nutzt ihn ausschliesslich fuer
# Scan-Trigger und das Aufloesen neuer Track-IDs.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=changeme

# --- Deemix ---------------------------------------------------------------
DEEMIX_URL=http://deemix:6595
# Deezer ARL Cookie. Wird ausschliesslich vom Deemix-Container verwendet.
DEEZER_ARL=
# 1=MP3 128 | 3=MP3 320 | 9=FLAC
DEEMIX_BITRATE=3

# --- Gateway --------------------------------------------------------------
# Erstes Login: Benutzer wird beim ersten Start angelegt, falls noch keiner
# existiert. Danach kann das Passwort im Dashboard geaendert werden.
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=change-me-now

# Zufaellig erzeugen:  openssl rand -hex 32
GATEWAY_SESSION_SECRET=

# true, sobald der Gateway hinter HTTPS laeuft (setzt Secure-Flag auf Cookies)
GATEWAY_SECURE_COOKIES=false

# Verhalten beim Abspielen eines noch nicht geladenen Titels:
#   defer  = kurzer Hinweis-Ton, Download startet im Hintergrund (robust)
#   stream = Verbindung offen halten und live mitstreamen (bessere UX, fragiler)
GATEWAY_STREAM_MODE=defer

# Marker, der an noch nicht geladene Titel angehaengt wird
GATEWAY_MARKER_SUFFIX= [Nicht heruntergeladen]

# Anzahl paralleler Worker-Jobs
GATEWAY_WORKER_CONCURRENCY=2

LOG_LEVEL=info
